# AURIS Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=auris_sovereign_jwt_secret_change_in_production
MONGO_URI=mongodb://localhost:27017/auris
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (Configure in Google Cloud Console)
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173, http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
